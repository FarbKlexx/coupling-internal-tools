# Vorlage fuer die .env auf dem Server. Kopieren, ausfuellen, NICHT einchecken:
#
#     cp env.example .env && chmod 600 .env
#
# Heisst bewusst ohne fuehrenden Punkt: .gitignore schliesst `.env.*` aus,
# eine Datei namens `.env.example` waere also nie im Repo gelandet und damit
# auch nie auf dem Server angekommen.
#
# Fehlt eine der beiden ADMIN_*-Variablen und existiert noch kein Konto,
# verweigert das Backend den Start - lieber ein roter Deploy als eine
# Anwendung, in die niemand hineinkommt.

# --------------------------------------------------------------------------
# Erstes Administratorkonto
# --------------------------------------------------------------------------
# Wirkt ausschliesslich beim allerersten Start, solange die Konten-Datenbank
# leer ist. Ein spaeter in der Oberflaeche geaendertes Passwort wird von einem
# Neustart NICHT ueberschrieben.
#
# ADMIN_USERNAME darf nicht "admin", "root", "administrator", "sa" oder "test"
# sein (ASVS 6.3.2 - keine Standardkonten).
# ADMIN_PASSWORD muss die Richtlinie erfuellen: mindestens 15 Zeichen, kein
# Firmen- oder Produktname, und nicht den Benutzernamen enthalten.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --------------------------------------------------------------------------
# Sitzungen
# --------------------------------------------------------------------------
# Die Werte sind in docs/authentifizierung.md, Abschnitt 4, begruendet. Wer
# sie aendert, aendert sie auch dort - ASVS 7.1.1 verlangt die dokumentierte
# Begruendung, das ist keine Formalie.
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=24

# Produktion laeuft ueber TLS: `Secure` an und das `__Host-`-Praefix, das
# `Secure` voraussetzt und ein `Domain`-Attribut verbietet.
SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECURE=1

# --------------------------------------------------------------------------
# Anmeldesperre
# --------------------------------------------------------------------------
# Gezaehlt wird pro (IP, Benutzername) - eine reine Benutzersperre waere selbst
# eine Waffe. Zweite Stufe ist `limit_req` in frontend/nginx.conf.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --------------------------------------------------------------------------
# Sonstiges
# --------------------------------------------------------------------------
# FastAPIs /docs, /redoc und /openapi.json. In Produktion aus: sie lagen zuvor
# nur deshalb nicht offen, weil die Basic Auth davorstand.
ENABLE_API_DOCS=0

# Die CORS-Liste mit den localhost-Origins. Standard ist bereits aus, hier nur
# der Vollstaendigkeit halber: in Produktion erreicht das Frontend das Backend
# ueber nginx, also same-origin und ganz ohne CORS. Eingeschaltet wird sie
# ausdruecklich in docker-compose.local.yml.
ALLOW_DEV_ORIGINS=0
